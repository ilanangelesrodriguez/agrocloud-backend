# Entorno local del Compose raiz. Copiar a .env y completar los valores requeridos.
# No usar COMPOSE_FILE: la entrada oficial es compose.yaml.
GATEWAY_PORT=4000
IDENTITY_PORT=8001
AGRICULTURAL_PORT=8002
AI_PORT=8003
BILLING_PORT=4001
NOTIFICATIONS_PORT=4002
GATEWAY_CORS_ORIGINS=http://localhost:3000

# Contraseñas independientes. AI y Notifications las interpolan en URLs:
# usar valores alfanumericos aleatorios o adaptar las URLs con escape correcto.
POSTGRES_DEV_PASSWORD=
IDENTITY_DB_PASSWORD=
AGRICULTURAL_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
AI_DB_PASSWORD=

# Cada APP_KEY: base64: seguido de 32 bytes aleatorios codificados en base64.
IDENTITY_APP_KEY=
AGRICULTURAL_APP_KEY=
# Claves internas y de firma: valores aleatorios diferentes de al menos 32 caracteres.
IDENTITY_SERVICE_API_KEY=
BILLING_SERVICE_API_KEY=
AI_SERVICE_API_KEY=
AGRICULTURAL_EVENT_SECRET=
AGROCLOUD_EVENT_SECRET=

# Conexiones internas del stack local (solo DNS Docker).
AGROCLOUD_EVENT_URL=http://ms-identity:8000/api/v1/internal/billing/events
NOTIFICATIONS_EVENT_URL=http://ms-notifications:3000/api/v1/internal/events/agricultural
# Modo predeterminado: timer del API Billing. Poner false antes de activar perfil events.
BILLING_OUTBOX_TIMER_ENABLED=true

# Identity: claves RSA persistentes se generan con identity:keys; nunca van en este archivo.
IDENTITY_FRONTEND_URL=http://localhost:3000
IDENTITY_TOKEN_ISSUER=agrocloud-identity
IDENTITY_TOKEN_AUDIENCE=agrocloud-api
IDENTITY_KEY_ID=identity-v1
IDENTITY_ACCESS_MINUTES=15
IDENTITY_REFRESH_DAYS=14
# Opcional, solo para el seed inicial; retirar estas credenciales despues de aprovisionar.
IDENTITY_BOOTSTRAP_EMAIL=
IDENTITY_BOOTSTRAP_PASSWORD=
# Catalogo comercial vacio: no habilita compras hasta definir ofertas y precios.
IDENTITY_BILLING_OFFERS='{}'

# Correo de Identity: el worker solo se activa con el perfil identity-mail.
IDENTITY_MAIL_HOST=localhost
IDENTITY_MAIL_PORT=587
IDENTITY_MAIL_SCHEME=smtp
IDENTITY_MAIL_USERNAME=
IDENTITY_MAIL_PASSWORD=
IDENTITY_MAIL_FROM_ADDRESS=identity@example.invalid

# Agricultural: excepciones de muestreo deshabilitadas por defecto.
AGRICULTURAL_FRONTEND_URL=http://localhost:3000
MANUAL_SAMPLING_ENABLED=false
SAMPLING_MAX_FRUITS=100000
SAMPLING_WARNING_FRUITS=500
SUNAT_RUC_URL=
SUNAT_RUC_KEY=

# Notifications: bandeja activa con worker; correo retenido hasta configurar SMTP.
NOTIFICATIONS_FRONTEND_URL=http://localhost:3000
NOTIFICATIONS_OPERATOR_KEY=
NOTIFICATIONS_MAIL_ENABLED=false
NOTIFICATIONS_SMTP_URL=
NOTIFICATIONS_MAIL_FROM=
NOTIFICATIONS_MAX_EVENT_RECIPIENTS=10000
NOTIFICATIONS_WORKER_INTERVAL_MS=1000
# Fuentes adicionales sin productor/fanout conectado actualmente; vacio las desactiva.
IDENTITY_EVENT_SECRET=
BILLING_EVENT_SECRET=

# Culqi: credenciales reales del entorno de pruebas, no llaves de ejemplo inventadas.
CULQI_SECRET_KEY=
CULQI_PUBLIC_KEY=
CULQI_WEBHOOK_TOKEN=

# IA: necesarios para inferencia; no se realizan llamadas externas al aprovisionar.
ROBOFLOW_API_KEY=
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=

# Swagger local: habilitar ejecución interactiva por servicio cuando se necesite.
IDENTITY_SWAGGER_TRY_IT_OUT=false
AGRICULTURAL_SWAGGER_TRY_IT_OUT=false
NOTIFICATIONS_SWAGGER_TRY_IT_OUT=false

# Originales agrícolas. Activar Cloudinary tras configurar las credenciales de arriba.
AGRICULTURAL_STORAGE_DRIVER=local
AGRICULTURAL_CLOUDINARY_PREFIX=agrocloud/agricultural



# Versión publicada del aviso y cupos aprobados para el alta gratuita.
IDENTITY_PRIVACY_VERSION=
IDENTITY_FREE_PLAN_DAYS=
IDENTITY_FREE_PLAN_USERS=
IDENTITY_FREE_PLAN_LOTS=
IDENTITY_FREE_PLAN_AI=
