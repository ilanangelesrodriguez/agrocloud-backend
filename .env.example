# Docker Compose local. Copy to .env and replace every empty required value.
GATEWAY_PORT=4000
IDENTITY_PORT=8001
AGRICULTURAL_PORT=8002
AI_PORT=8003
BILLING_PORT=4001
NOTIFICATIONS_PORT=4002

POSTGRES_DEV_PASSWORD=
IDENTITY_DB_PASSWORD=
AGRICULTURAL_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
# Use a random alphanumeric password (embedded in the SQLAlchemy URL).
AI_DB_PASSWORD=
# Each Laravel key: base64: followed by 32 random bytes encoded as base64.
IDENTITY_APP_KEY=
AGRICULTURAL_APP_KEY=
BILLING_SERVICE_API_KEY=
AI_SERVICE_API_KEY=
CULQI_SECRET_KEY=
CULQI_PUBLIC_KEY=
CULQI_WEBHOOK_TOKEN=
AGROCLOUD_EVENT_SECRET=
# Leave empty until Identity implements a signed, idempotent event receiver.
AGROCLOUD_EVENT_URL=
# Set false when enabling the dedicated events profile worker.
BILLING_OUTBOX_TIMER_ENABLED=true
ROBOFLOW_API_KEY=
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
