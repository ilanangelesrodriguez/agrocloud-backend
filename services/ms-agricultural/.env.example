APP_NAME=AgroCloud-Agricultural
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agricultural_db
DB_USERNAME=agricultural_app
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Direct local execution; Compose uses container DNS instead.
IDENTITY_SERVICE_URL=http://127.0.0.1:8001
IDENTITY_SERVICE_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:8003
AI_SERVICE_API_KEY=
AGRICULTURAL_FRONTEND_URL=http://localhost:3000
# Leave empty until ms-notifications implements the signed domain-event contract.
NOTIFICATIONS_EVENT_URL=
AGRICULTURAL_EVENT_SECRET=
MANUAL_SAMPLING_ENABLED=false
SAMPLING_MAX_FRUITS=100000
SAMPLING_WARNING_FRUITS=500
SUNAT_RUC_URL=
SUNAT_RUC_KEY=

# Ejecución desde Swagger en desarrollo local.
SWAGGER_TRY_IT_OUT=false

AGRICULTURAL_STORAGE_DRIVER=local
AGRICULTURAL_CLOUDINARY_PREFIX=agrocloud/agricultural
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=

NOTIFICATIONS_CLOUD_RUN_AUDIENCE=
