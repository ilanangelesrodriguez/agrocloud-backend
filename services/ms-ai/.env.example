# Copiar a .env. Nunca subir claves a Git.
APP_ENV=development
DATABASE_URL="postgresql+psycopg://USUARIO:CLAVE@SERVIDOR_DIRECTO/BASE_IA?sslmode=require&channel_binding=require"
AUTO_CREATE_TABLES=false

SERVICE_API_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
ROBOFLOW_API_KEY=
# Proyecto consultado en Roboflow: ilan-angeles/agrocloud-plagas-de-palta
ROBOFLOW_WORKSPACE=ilan-angeles
ROBOFLOW_MODEL_ID=ilan-angeles/agrocloud-plagas-de-palta-2-rfdetr-small-t1
ROBOFLOW_TRAINED_MODEL_ID=ilan-angeles/agrocloud-plagas-de-palta-2-rfdetr-small-t1
ROBOFLOW_MODE=model
ROBOFLOW_WORKFLOW_ID=agrocloud-plagas-de-palta
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_TIMEOUT_SECONDS=90
MIN_CONFIDENCE=0.20
HIGH_CONFIDENCE=0.75
MAX_IMAGE_MB=3
MAX_IMAGE_PIXELS=16000000
MAX_BATCH_SIZE=5
MAX_CONCURRENT_INFERENCES=3
# Las imágenes anotadas se almacenan en Cloudinary.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=agrocloud/ai/rfdetr-v2
