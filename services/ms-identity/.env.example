APP_NAME=AgroCloud-Identity
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=identity_db
DB_USERNAME=identity_app
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identity API: generate a key pair with php artisan identity:keys (not run automatically).
IDENTITY_TOKEN_ISSUER=agrocloud-identity
IDENTITY_TOKEN_AUDIENCE=agrocloud-api
IDENTITY_KEY_ID=identity-v1
IDENTITY_ACCESS_MINUTES=15
IDENTITY_REFRESH_DAYS=14
IDENTITY_FRONTEND_URL=http://localhost:3000
IDENTITY_SERVICE_API_KEY=
# Optional absolute paths; defaults are storage/app/identity/{private,public}.pem.
# IDENTITY_PRIVATE_KEY_PATH=
# IDENTITY_PUBLIC_KEY_PATH=

# Used only when explicitly running DatabaseSeeder; never a default password.
IDENTITY_BOOTSTRAP_EMAIL=
IDENTITY_BOOTSTRAP_PASSWORD=

# Direct local execution. Compose overlay uses the Billing container hostname.
BILLING_SERVICE_URL=http://127.0.0.1:4001
BILLING_SERVICE_API_KEY=
# URL canónica del servicio Billing privado en Cloud Run. Dejar vacía en local.
BILLING_CLOUD_RUN_AUDIENCE=
AGROCLOUD_EVENT_SECRET=
# JSON object of approved offers. Empty disables checkout until prices/quotas are agreed.
IDENTITY_BILLING_OFFERS='{}'
# Foto de perfil en Cloudinary (solo Identity, nunca exponer al frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUNAT_RUC_URL=
SUNAT_RUC_KEY=
SUNAT_RUC_CACHE_SECONDS=86400

# Ejecución desde Swagger en desarrollo local.
SWAGGER_TRY_IT_OUT=false

# Misma clave de firma configurada en Gateway.
IDENTITY_GATEWAY_CLIENT_IP_KEY=

# Versión publicada del aviso y cupos aprobados para el alta gratuita.
IDENTITY_PRIVACY_VERSION=
IDENTITY_FREE_PLAN_DAYS=
IDENTITY_FREE_PLAN_USERS=
IDENTITY_FREE_PLAN_LOTS=
IDENTITY_FREE_PLAN_AI=

# Sandbox unicamente. Nunca habilitar con una cuenta Culqi live.
IDENTITY_BILLING_SANDBOX_CHECKOUT_ENABLED=false

NOTIFICATIONS_EVENT_URL=
NOTIFICATIONS_CLOUD_RUN_AUDIENCE=
IDENTITY_EVENT_SECRET=
