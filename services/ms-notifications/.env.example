NODE_ENV=development
PORT=4002
# PostgreSQL propio; no consultar tablas de otros servicios. Escapar caracteres de la URL.
DATABASE_URL=postgresql://notifications_app:REEMPLAZAR@127.0.0.1:5432/notifications_db
IDENTITY_SERVICE_URL=http://127.0.0.1:8001
IDENTITY_SERVICE_API_KEY=
# Vacío desactiva la recepción de esa fuente. Usar secretos distintos de 32+ caracteres.
AGRICULTURAL_EVENT_SECRET=
IDENTITY_EVENT_SECRET=
BILLING_EVENT_SECRET=
NOTIFICATIONS_OPERATOR_KEY=
FRONTEND_URL=http://localhost:3000
MAX_EVENT_RECIPIENTS=10000
WORKER_INTERVAL_MS=1000
# Sin SMTP el worker procesa bandeja/eventos y conserva los correos pendientes.
MAIL_ENABLED=false
SMTP_URL=
MAIL_FROM=
